# rfp-service 설정 예시 — 이 파일을 .env로 복사해 채운다.
# 실제 키는 .env에만 두고, .env는 .gitignore에 있다.

# 서비스가 자기 상태를 보고할 때 쓰는 이름
RFP_SERVICE_NAME=rfp-service

# 검색기 선택 — 현재 구현된 값은 keyword 하나뿐이다.
# dense / hybrid 는 슬롯만 있고 아직 구현돼 있지 않다(선택 시 503).
RFP_RETRIEVER=keyword

# 한 번에 돌려줄 근거 chunk 수의 기본값·상한
RFP_TOP_K=5
RFP_MAX_TOP_K=20

# 인덱싱할 문서 디렉터리 (비우면 빈 인덱스로 뜬다)
RFP_CORPUS_DIR=

# --- 아직 쓰이지 않는 값 (답변 생성 붙일 때 사용) ---
# 비어 있으면 /ask 는 근거만 돌려주고 생성은 하지 않는다.
OPENAI_API_KEY=
RFP_ANSWER_MODEL=
